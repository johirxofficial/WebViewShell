<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Structure only. Colors come from app-config.properties. -->
    <style name="Theme.WebViewShell" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand_light</item>
        <item name="android:statusBarColor">@color/system_bar</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.WebViewShell.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.WebViewShell</item>
    </style>
</resources>
